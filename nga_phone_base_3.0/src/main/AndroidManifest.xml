<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="gov.anzong.androidnga"
    android:configChanges="orientation|screenSize"
    android:installLocation="auto"
    android:largeHeap="true">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <application
        android:name=".NgaClientApp"
        android:anyDensity="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/label_activity_main"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppThemeDayNight"
        tools:ignore="AllowBackup"
        tools:replace="android:label">
        <meta-data android:name="EasyGoClient" android:value="true" />
        <!-- Android 16(API 36) 起，大屏设备（smallestWidth >= 600dp）会忽略 activity 的屏幕方向锁定。
             声明该协议属性后仍按 portrait 锁定，避免平板/折叠屏上被系统强制拉到横屏。 -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity android:screenOrientation="portrait"
            android:name=".activity.MainActivity"
            android:configChanges="orientation|screenSize|locale|screenLayout|smallestScreenSize"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:exported="true">

            <!-- add static shortcut -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/static_shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:screenOrientation="portrait" android:name=".activity.ProfileActivity" />
        <activity android:screenOrientation="portrait"
            android:name=".activity.PostActivity"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait"
            android:name=".activity.AvatarPostActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait"
            android:name=".activity.SignPostActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:screenOrientation="portrait"
            android:name=".activity.SettingsActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/menu_setting"
            android:launchMode="singleTop" />

        <activity android:screenOrientation="portrait"
            android:name=".activity.TopicListActivity"
            android:configChanges="orientation|screenSize|locale|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="bbs.nga.cn"
                    android:path="/thread.php"
                    android:scheme="http" />

                <data
                    android:host="bbs.ngacn.cc"
                    android:path="/thread.php"
                    android:scheme="http" />

                <data
                    android:host="nga.178.com"
                    android:path="/thread.php"
                    android:scheme="http" />

                <data
                    android:host="bbs.nga.cn"
                    android:path="/thread.php"
                    android:scheme="https" />

                <data
                    android:host="bbs.ngacn.cc"
                    android:path="/thread.php"
                    android:scheme="https" />

                <data
                    android:host="nga.178.com"
                    android:path="/thread.php"
                    android:scheme="https" />

                <data
                    android:host="ngabbs.com"
                    android:path="/thread.php"
                    android:scheme="https" />

                <data
                    android:host="ngabbs.com"
                    android:path="/thread.php"
                    android:scheme="https" />

            </intent-filter>
        </activity>

        <activity android:screenOrientation="portrait"
            android:name=".activity.ArticleListActivity"
            android:configChanges="orientation|screenSize|locale|screenLayout|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="nga.178.com"
                    android:path="/read.php"
                    android:scheme="http" />
                <data
                    android:host="bbs.ngacn.cc"
                    android:path="/read.php"
                    android:scheme="http" />
                <data
                    android:host="bbs.nga.cn"
                    android:path="/read.php"
                    android:scheme="http" />

                <data
                    android:host="nga.178.com"
                    android:path="/read.php"
                    android:scheme="https" />
                <data
                    android:host="bbs.ngacn.cc"
                    android:path="/read.php"
                    android:scheme="https" />
                <data
                    android:host="bbs.nga.cn"
                    android:path="/read.php"
                    android:scheme="https" />

                <data
                    android:host="ngabbs.com"
                    android:path="/read.php"
                    android:scheme="https" />

                <data
                    android:host="ngabbs.com"
                    android:path="/read.php"
                    android:scheme="https" />

            </intent-filter>
        </activity>
        <activity android:screenOrientation="portrait" android:name=".gallery.ImageZoomActivity" />
        <activity android:screenOrientation="portrait" android:name=".activity.RecentNotificationActivity" />
        <activity android:screenOrientation="portrait" android:name=".activity.LauncherSubActivity" />

        <activity android:screenOrientation="portrait" android:name=".activity.compose.TemplateComposeActivity" />

        <activity android:screenOrientation="portrait"
            android:name=".activity.compose.SearchActivity"
            android:label="@string/search" />

        <activity android:screenOrientation="portrait"
            android:name=".activity.AboutActivity"
            android:label="@string/title_about" />

        <activity android:screenOrientation="portrait" android:name=".activity.TopicCacheActivity" android:label="我的缓存" />
        <activity android:screenOrientation="portrait" android:name=".activity.ArticleCacheActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>